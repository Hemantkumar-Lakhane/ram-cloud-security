# ==============================================================================
# RAM CLOUD SECURITY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' for local development.
# NEVER commit real credentials, API keys, or access secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# AWS Configuration (Use IAM roles, AWS profiles, or temporary credentials)
# Recommended: Configure via AWS CLI (`aws configure`) or instance metadata
AWS_REGION=us-east-1
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Data Lake / Storage Configuration
SECURITY_DATA_LAKE_BUCKET=ram-cloud-security-data-lake
SECURITY_DATA_LOCAL_DIR=./data

# Ingestion Settings
CLOUDTRAIL_INGESTION_SOURCE=local  # options: local, s3, cloudwatch
CLOUDTRAIL_POLL_INTERVAL_SECONDS=60

# Detection & Risk Thresholds
ML_ANOMALY_THRESHOLD=0.75
RISK_SCORE_HIGH_THRESHOLD=80
RISK_SCORE_MEDIUM_THRESHOLD=50

# Response Orchestration (Safety Settings)
AUTOMATED_RESPONSE_ENABLED=false
SAFE_MODE=true
DRY_RUN=true
